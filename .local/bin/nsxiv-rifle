#!/bin/sh

# Made by rabbi-lion
# License: GNU GPLv3

set -eu

IMAGE_RE='\.(jpe?g|png|gif|svg|jxl|webp|tiff?|heif|heic|avif|ico|bmp|pam|pbm|pgm|ppm|tga|qoi|ff)$'

uri_path() {
    python3 - "$1" <<'PY'
from sys import argv
from urllib.parse import unquote, urlparse

print(unquote(urlparse(argv[1]).path))
PY
}

open_from_directory() {
    target=$1
    shift

    directory=${target%/*}
    list=$(mktemp "${TMPDIR:-/tmp}/nsxiv-rifle.XXXXXX")
    trap 'rm -f "$list"' EXIT HUP INT TERM

    find -L "$directory" -maxdepth 1 -type f -print \
        | grep -Ei "$IMAGE_RE" \
        | LC_ALL=C sort > "$list" || true

    number=$(awk -v file="$target" '$0 == file { print NR; exit }' "$list")

    if [ -n "$number" ]; then
        nsxiv -i -n "$number" "$@" < "$list"
    else
        nsxiv "$target" "$@"
    fi
}

[ "$#" -gt 0 ] || {
    printf 'Usage: %s PICTURE [OPTIONS...]\n' "${0##*/}" >&2
    exit 1
}

input=$1
shift

case "$input" in
    /*)
        open_from_directory "$input" "$@"
        ;;
    "~"/*)
        open_from_directory "$HOME/${input#"~"/}" "$@"
        ;;
    file:///*)
        open_from_directory "$(uri_path "$input")" "$@"
        ;;
    trash:///*)
        trash_root="${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files"
        open_from_directory "${trash_root}$(uri_path "$input")" -N nsxiv_trash "$@"
        ;;
    *)
        open_from_directory "$PWD/$input" "$@"
        ;;
esac
